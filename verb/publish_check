#!/usr/bin/env bash
#@ purpose: Dry-run `cargo publish` for every publishable crate, in dependency order. Packages
#@          each one and builds it from the package, as crates.io would; siblings not yet on
#@          crates.io resolve locally. crate::<name> narrows to one package. Uploads nothing.
#@ tags: verb, publish_check
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

_crate=""
_dry_run=0
for _arg in "$@"; do
  case "$_arg" in
    crate::*)
      _crate="${_arg#crate::}"
      if [[ -z "$_crate" ]]; then
        echo "verb/publish_check: crate::<name> cannot be empty" >&2
        exit 2
      fi
      ;;
    dry::1) _dry_run=1 ;;
    *)
      echo "verb/publish_check: unrecognized parameter '$_arg' — expected crate::<name> or dry::1" >&2
      exit 2
      ;;
  esac
done

if [[ -n "$_crate" ]]; then
  _cmd=( cargo publish --dry-run --allow-dirty -p "$_crate" )
else
  _cmd=( cargo publish --dry-run --allow-dirty --workspace )
fi

if (( _dry_run )); then
  printf '%s\n' "${_cmd[*]}"
  exit 0
fi

exec "${_cmd[@]}"
