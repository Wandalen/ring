  "protocol": {
    "per_push_atomics": "one Release store of the producer cursor (STLR); the producer loads the consumer cursor only when its cache says full",
    "per_pop_atomics_before_41": "one Acquire load of the producer cursor (LDAPR) on every drain_up_to, one Release store of the consumer cursor (STLUR) per batch",
    "per_pop_atomics_after_41": "the Acquire load only when the consumer knows of fewer records than the drain asks for",
    "orderings": {
      "OWN": "Relaxed",
      "GATING": "Acquire",
      "HANDOFF": "Release"
    },
