#!/usr/bin/env bash
#@ purpose: Remove build artifacts (target/, target-loom/) and gate scratch logs.
#@ tags: verb, clean
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

_dry_run=0
for _arg in "$@"; do
  case "$_arg" in
    dry::1) _dry_run=1 ;;
    *)
      echo "verb/clean: unrecognized parameter '$_arg' — expected dry::1" >&2
      exit 2
      ;;
  esac
done

if (( _dry_run )); then
  printf 'cargo clean\n'
  printf 'rm -rf target-loom\n'
  printf 'rm -f ./-[0-9][0-9][0-9][0-9]_*.log\n'
  exit 0
fi

cargo clean
rm -rf target-loom
rm -f ./-[0-9][0-9][0-9][0-9]_*.log
