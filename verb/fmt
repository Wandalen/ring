#!/usr/bin/env bash
#@ purpose: Apply this repo's adopted rustfmt style (rustfmt.toml) across the
#@          whole workspace. check::1 verifies without writing (CI-safe);
#@          default applies in place. Must run under +nightly — rustfmt.toml's
#@          unstable_features (group_imports, imports_layout) silently no-op
#@          on stable.
#@ tags: verb, fmt
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

_check=0
_dry_run=0
for _arg in "$@"; do
  case "$_arg" in
    check::1) _check=1 ;;
    dry::1)   _dry_run=1 ;;
    *)
      echo "verb/fmt: unrecognized parameter '$_arg' — expected check::1 or dry::1" >&2
      exit 2
      ;;
  esac
done

_cmd=( cargo +nightly fmt --all )
(( _check )) && _cmd+=( -- --check )

if (( _dry_run )); then
  printf '%s\n' "${_cmd[*]}"
  exit 0
fi

exec "${_cmd[@]}"
