#!/usr/bin/env bash
#@ purpose: Format the workspace: Rust with nightly rustfmt (rustfmt.toml), TOML with
#@          taplo (taplo.toml). check::1 verifies without writing (CI-safe). Nightly is
#@          required — rustfmt.toml's unstable options silently no-op on stable.
#@ tags: verb, fmt
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

_check=0
_dry_run=0
for _arg in "$@"; do
  case "$_arg" in
    check::1) _check=1 ;;
    dry::1)   _dry_run=1 ;;
    *)
      echo "verb/fmt: unrecognized parameter '$_arg' — expected check::1 or dry::1" >&2
      exit 2
      ;;
  esac
done

_rust=( cargo +nightly fmt --all )
_toml=( taplo fmt )
if (( _check )); then
  _rust+=( -- --check )
  _toml+=( --check )
fi

if (( _dry_run )); then
  printf '%s\n' "${_rust[*]}" "RUST_LOG=error ${_toml[*]}"
  exit 0
fi

"${_rust[@]}"
RUST_LOG=error "${_toml[@]}"
