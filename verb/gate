#!/usr/bin/env bash
#@ purpose: Dispatch to bench_harness's own corpus/quality gate suite (G1-G21).
#@          family::<name> (default ring), gate::<name> (repeatable, e.g. gate::g15),
#@          stage::<name> (e.g. stage::S4). No params runs every declared gate.
#@ tags: verb, gate
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

_family="ring"
_stage=""
_gates=()
_dry_run=0
for _arg in "$@"; do
  case "$_arg" in
    family::*) _family="${_arg#family::}" ;;
    stage::*)  _stage="${_arg#stage::}" ;;
    gate::*)   _gates+=( "${_arg#gate::}" ) ;;
    dry::1)    _dry_run=1 ;;
    *)
      echo "verb/gate: unrecognized parameter '$_arg' — expected family::<name>, gate::<name>, stage::<name>, or dry::1" >&2
      exit 2
      ;;
  esac
done

# run_all.sh's own usage examples fix this order: `--family ring --stage S4`, and
# separately `--stage S1 g1 g3` — stage comes before gate names, not after.
_cmd=( bash gate/run_all.sh --family "$_family" )
[[ -n "$_stage" ]] && _cmd+=( --stage "$_stage" )
(( ${#_gates[@]} > 0 )) && _cmd+=( "${_gates[@]}" )

if (( _dry_run )); then
  printf '( cd bench_harness && %s )\n' "${_cmd[*]}"
  exit 0
fi

cd bench_harness
exec "${_cmd[@]}"
