#!/usr/bin/env bash
#@ purpose: Rebuild rustdoc from a clean slate. Always rm -rf target/doc first —
#@          incremental `cargo doc` silently skips re-checking unchanged crates, which
#@          hides broken intra-doc links there (see reference_cargo_doc_incremental_hides_errors).
#@ tags: verb, doc
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

_dry_run=0
for _arg in "$@"; do
  case "$_arg" in
    dry::1) _dry_run=1 ;;
    *)
      echo "verb/doc: unrecognized parameter '$_arg' — expected dry::1" >&2
      exit 2
      ;;
  esac
done

if (( _dry_run )); then
  printf 'rm -rf target/doc\n'
  printf 'RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --all-features --keep-going\n'
  exit 0
fi

rm -rf target/doc
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --all-features --keep-going
