#!/usr/bin/env bash
#@ purpose: Run ring_bench's comparison example, the family's own benchmark.
#@ tags: verb, bench
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

_dry_run=0
for _arg in "$@"; do
  case "$_arg" in
    dry::1) _dry_run=1 ;;
    *)
      echo "verb/bench: unrecognized parameter '$_arg' — expected dry::1" >&2
      exit 2
      ;;
  esac
done

_cmd=( cargo run -p ring_bench --all-features --example comparison )

if (( _dry_run )); then
  printf '%s\n' "${_cmd[*]}"
  exit 0
fi

exec "${_cmd[@]}"
