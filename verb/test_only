#!/usr/bin/env bash
#@ purpose: Filtered nextest run — filter::<substring> and/or crate::<name>. Ordinary
#@          verification during active development only; use test for the full gate.
#@ tags: verb, test_only
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

_filter=""
_crate=""
_dry_run=0
for _arg in "$@"; do
  case "$_arg" in
    filter::*)
      _filter="${_arg#filter::}"
      if [[ -z "$_filter" ]]; then
        echo "verb/test_only: filter::<substr> cannot be empty" >&2
        exit 2
      fi
      ;;
    crate::*)
      _crate="${_arg#crate::}"
      if [[ -z "$_crate" ]]; then
        echo "verb/test_only: crate::<name> cannot be empty" >&2
        exit 2
      fi
      ;;
    dry::1)    _dry_run=1 ;;
    *)
      echo "verb/test_only: unrecognized parameter '$_arg' — expected filter::<substr>, crate::<name>, or dry::1" >&2
      exit 2
      ;;
  esac
done

_cmd=( cargo nextest run --all-features )
[[ -n "$_crate" ]]  && _cmd+=( -p "$_crate" )
[[ -n "$_filter" ]] && _cmd+=( "$_filter" )

if (( _dry_run )); then
  printf '%s\n' "${_cmd[*]}"
  exit 0
fi

exec "${_cmd[@]}"
