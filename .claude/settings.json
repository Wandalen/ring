{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./verb/*)",
      "Bash(./bench_harness/verb/*)",
      "Bash(./ring_*/verb/*)",
      "Bash(just *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo doc *)",
      "Bash(cargo nextest *)",
      "Bash(cargo test *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo +nightly fmt *)",
      "Bash(rustfmt +nightly *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(jq *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/rustfmt_edited.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
